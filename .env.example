# Web (Vite). Only VITE_ variables are exposed to the browser.
VITE_API_URL=http://127.0.0.1:3001

# Express API
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Relative paths are resolved from the repository root.
# The database file is created locally and is gitignored.
DATABASE_PATH=data/evertold.sqlite

# Python transcription service
TRANSCRIPTION_HOST=127.0.0.1
TRANSCRIPTION_PORT=8000
TRANSCRIPTION_URL=http://127.0.0.1:8000
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Gemma via Ollama. When OLLAMA_MODEL is unset, the API uses ai/gemma/model.json.
# If Ollama is not running, the app says so and does not invent insights.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3
